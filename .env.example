# Pasta data do ml-jrf (montada só leitura em /app/mljrf), caminho absoluto
MLJRF_DATA_DIR=
# Ping do ml-jrf para conferir/renovar o token num 401
ML_JRF_PING_URL=

# Discord: webhook do canal de vendas e cargo que recebe o ping
DISCORD_WEBHOOK_URL=
DISCORD_ROLE_ID=
# Link do site nas mensagens do Discord
SITE_URL=

# Alerta (dias úteis, sem feriados nacionais)
ALERTA_ATIVO=1
ALERTA_INICIO=09:30
ALERTA_FIM=16:00
ALERTA_INTERVALO_MIN=10
ALERTA_LIMITE=2
ALERTA_LEMBRETE_MIN=120

# Processamento
AVISO_DEMORA_MIN=30
INTERVALO_CONSULTA=20
DIAS_BUSCA=15
HISTORICO_DIAS=30

# Estoque de devoluções (MySQL, só leitura)
DB_HOST=
DB_PORT=
DB_USER=
DB_PASS=
DB_NAME=
DB_SSL_CA=/app/mysql-ca.pem
